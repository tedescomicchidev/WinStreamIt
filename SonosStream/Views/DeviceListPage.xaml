<Page
    x:Class="SonosStream.Views.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SonosStream.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Device list ──────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,8">

                <!-- Empty state -->
                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Padding="0,60,0,0">
                    <FontIcon Glyph="&#xE995;" FontSize="48"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="No Sonos speakers found"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Make sure your speakers are powered on and on the same network, then tap Rescan."
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <!-- Device cards -->
                <ItemsControl x:Name="DeviceItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceViewModel">
                            <Border Margin="0,6"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Speaker icon -->
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE995;"
                                              FontSize="28"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                    <!-- Device info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind FriendlyName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ModelName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind StreamButtonLabel, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Volume slider -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="Volume"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Slider x:Name="VolumeSlider"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{x:Bind Volume, Mode=TwoWay}"
                                                StepFrequency="1"
                                                TickFrequency="10"
                                                TickPlacement="None"
                                                ValueChanged="VolumeSlider_ValueChanged"
                                                Tag="{x:Bind}" />
                                    </StackPanel>

                                    <!-- Play / Stop button -->
                                    <Button Grid.Column="3"
                                            Content="{x:Bind ToggleButtonLabel, Mode=OneWay}"
                                            Command="{x:Bind ToggleStreamCommand}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Error InfoBar ────────────────────────────────────────────── -->
        <InfoBar Grid.Row="1"
                 x:Name="ErrorInfoBar"
                 IsOpen="False"
                 Severity="Error"
                 Margin="16,0" />

        <!-- ── Bottom command bar ───────────────────────────────────────── -->
        <Border Grid.Row="2"
                Padding="16,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status text -->
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock x:Name="StreamUrlBlock"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True" />
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <Button x:Name="StreamAllButton"
                            Click="StreamAllButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Stream to All" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="StopAllButton"
                            Click="StopAllButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                            <TextBlock Text="Stop All" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RescanButton"
                            Click="RescanButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Rescan" />
                        </StackPanel>
                    </Button>

                    <ProgressRing x:Name="ScanProgressRing"
                                  IsActive="False"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
